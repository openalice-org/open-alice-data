# Copy to .env and fill in. All values are optional unless a step needs them. Never commit .env.
# OpenAlex API key (corpus, extract_authors, fetch_global_h_index)
OPENALEX_API_KEY=
# Contact e-mail sent to OpenAlex / EPO (polite pool); leave empty to send none
OPENALEX_MAILTO=
# EPO OPS credentials (only for PATENTS=full)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET_KEY=
# Folder with Eikos-4B/ and the OpenVINO export (default models/eikos)
EIKOS_DIR=
# Python of the OpenVINO env (default .venv-openvino/bin/python)
NPU_PY=
# Extra LD_LIBRARY_PATH for a version-skewed NPU compiler package (usually empty)
NPU_LIB=
# OpenVINO device for rescue embedding (default NPU)
EMBED_DEVICE=
# OpenVINO device for Eikos labelling (default GPU)
LABEL_DEVICE=
# cgroup memory cap for the rescue jobs when systemd-run exists (default 7G)
MEM_CAP=
# Patents: cache (default) | full | skip
PATENTS=
# Rescue pass in split: 1 (default) uses the rescued corpus if present, 0 forces rule-only
RESCUE=
# Where `make stage` collects the 5 JSONs (default build/data)
STAGE_DIR=
# Where `make publish` copies them (default ../open-alice/public/data)
APP_PUBLIC=
